# chezmoi: run_once_after_set-xdg.ps1.tmpl
# Windows only.
#
# Windows does not define HOME, and nushell/PowerShell/other XDG-aware tools fall
# back to it when a specific XDG variable is missing. direnv resolves its three
# directories separately and aborts on the first one it cannot find, which is why
# a terminal opened with only XDG_CONFIG_HOME set prints:
#
#   direnv: error couldn't find a cache directory for direnv
#
# Setting all three keeps the ~/.config, ~/.cache and ~/.local/share triad
# identical to Linux, which is the point of this repository.
#
# The data dir ($nu.data-dir: history, plugin registry, vendor autoload) stays in
# %APPDATA%\nushell on purpose; only these XDG locations move.
#
# GH_CONFIG_DIR pins `gh` back to its native Windows location. GitHub CLI prefers
# $XDG_CONFIG_HOME when it is set (it looks for $XDG_CONFIG_HOME/gh), but on
# Windows it keeps its config and auth in %APPDATA%\GitHub CLI. With XDG set and
# nothing else, `gh auth status` answers "You are not logged into any GitHub
# hosts" even with a valid session; `GH_CONFIG_DIR` restores it and covers every
# shell at once (PowerShell, nushell and Git Bash alike), instead of patching one
# profile at a time.
{{ if ne .chezmoi.os "windows" -}}
# Not on Windows — skip
exit 0
{{ end -}}
$dirs = [ordered]@{
    "XDG_CONFIG_HOME" = Join-Path $env:USERPROFILE ".config"
    "XDG_CACHE_HOME"  = Join-Path $env:USERPROFILE ".cache"
    "XDG_DATA_HOME"   = Join-Path $env:USERPROFILE ".local\share"
    "GH_CONFIG_DIR"   = Join-Path ([Environment]::GetFolderPath("ApplicationData")) "GitHub CLI"
}

$changed = $false
foreach ($name in $dirs.Keys) {
    $want = $dirs[$name]
    $current = [Environment]::GetEnvironmentVariable($name, "User")
    if ($current -eq $want) {
        Write-Host "$name already set to $want"
        continue
    }
    [Environment]::SetEnvironmentVariable($name, $want, "User")
    Write-Host "$name set to $want (user scope)"
    $changed = $true
}

if ($changed) {
    Write-Host "Open a new terminal for it to take effect."
}
