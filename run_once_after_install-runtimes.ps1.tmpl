# chezmoi: run_once_after_install-runtimes.ps1.tmpl
# Windows only.
#
# mise owns node, pnpm, go, uv, gh and bun on every platform; the package lists
# only install mise itself. This runs *after* the file targets so
# ~/.config/mise/config.toml already exists when mise reads it.
{{ if ne .chezmoi.os "windows" -}}
# Not on Windows — skip
exit 0
{{ end -}}
if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Warning "mise not found — runtimes skipped."
    exit 0
}

# mise writes real shims here. They must come FIRST among the package managers:
# mise is the declared owner of node, pnpm, go, uv, gh and bun, and a Scoop
# package that ships one of them later would shadow it silently — which is
# exactly what happened with gh and uv before. Idempotent: the variable is
# rewritten only when the entry is not already at the front.
$shims = Join-Path $env:LOCALAPPDATA "mise\shims"
$userPath = [Environment]::GetEnvironmentVariable("Path", "User")
$entries = @($userPath -split ";" | Where-Object { $_ -and $_ -ne $shims })
$newUserPath = (@($shims) + $entries) -join ";"

if ($newUserPath -ne $userPath) {
    [Environment]::SetEnvironmentVariable("Path", $newUserPath, "User")
    Write-Host "mise shims moved to the front of the user PATH"
}
if ($env:PATH -notlike "$shims*") {
    $rest = @($env:PATH -split ";" | Where-Object { $_ -and $_ -ne $shims }) -join ";"
    $env:PATH = "$shims;$rest"
}

Write-Host "Installing runtimes from mise.toml..."
mise install

# uv drops the global python/python3 executables in ~/.local/bin. Prepend it so
# it wins over the Microsoft Store stub in WindowsApps.
$localBin = Join-Path $env:USERPROFILE ".local\bin"
$userPath = [Environment]::GetEnvironmentVariable("Path", "User")
if ($userPath -notlike "*$localBin*") {
    [Environment]::SetEnvironmentVariable("Path", "$localBin;$userPath", "User")
    Write-Host "Added $localBin to the front of the user PATH"
}
if ($env:PATH -notlike "*$localBin*") {
    $env:PATH = "$localBin;$env:PATH"
}

# nushell deliberately does not get `mise activate`: its `source` is resolved at
# parse time and hard-fails when the target is missing (a `path exists` guard
# does not help), the generated script embeds this machine's PATH so it cannot
# be vendored, and nothing would generate it on Linux. Everything mise manages
# already resolves in nushell through the shims on the user PATH.

mise ls
