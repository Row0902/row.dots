{{- $name := promptStringOnce . "git.user_name" "Git user name" "set later in ~/.chezmoi.toml" -}}
{{- $email := promptStringOnce . "git.user_email" "Git user email" "set later in ~/.chezmoi.toml" -}}
{{- $key := promptStringOnce . "git.signingkey" "SSH signing key (public key line, empty if none)" "set later in ~/.chezmoi.toml" -}}
[data.git]
    user_name = {{ $name | quote }}
    user_email = {{ $email | quote }}
    signingkey = {{ $key | quote }}

[git]
    autoAdd = true
    # autoCommit stays off: sync commits are meaningless in a dotfiles repo.
    # Enable it per machine with `chezmoi git -- commit` or set autoCommit = true.
    autoCommit = false
    autoPush = false
    commitMessageTemplate = "chore(dots): sync dotfiles"

# Editor used by `chezmoi edit`. .chezmoidata.toml is NOT available while this
# config template renders, so resolve it against the machine's PATH instead.
{{- if lookPath "code" }}
[edit]
    command = "code --wait"
{{- else if lookPath "nvim" }}
[edit]
    command = "nvim"
{{- end }}

{{- if lookPath "delta" }}
[diff]
    pager = "delta"
{{- end }}

# Interpreters.ps1 no declarado explícitamente para que chezmoi maneje
# el auto-fallback: pwsh → powershell.exe en Windows, pwsh en Unix.
# Ver https://chezmoi.io/reference/configuration-file/interpreters/

# Encripción age para archivos sensibles.
# Descomentar después de generar la clave:
#   chezmoi age-keygen --output=~/.config/chezmoi/key.txt
# y copiar la public key como recipient.
#
# encryption = "age"
# [age]
#     identity = "~/.config/chezmoi/key.txt"
#     recipient = "age1..."
