# chezmoi: run_once_before_install-packages.ps1.tmpl
# Provisioner de Windows.
#
# The order is the same on both platforms, and it is deliberate:
#   1. install the package manager
#   2. update the manager and its catalogues  <- before installing anything
#   3. declare buckets and apps               <- scoopfile.json / Brewfile
#   4. install what no portable manager ships (system integration, via winget)
#   5. clean up old versions and the download cache
#
# The app list is NOT kept here: it lives in scoopfile.json, which is the format
# `scoop export` produces, so the file round-trips and the list has one owner.
{{ if ne .chezmoi.os "windows" -}}
# Not on Windows — skip
exit 0
{{ end -}}
$ErrorActionPreference = "Continue"

# Integración con el sistema: winget
$wingetPackages = @(
    "Git.Git",
    "Microsoft.PowerShell",
    # rustup owns cargo/rustc and its own toolchains; mise stays out of rust.
    "Rustlang.Rustup"
)

# ── 1. Scoop ──────────────────────────────────────────────────────────
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Scoop..."
    Set-ExecutionPolicy -Scope CurrentUser RemoteSigned -Force
    Invoke-RestMethod -Uri "https://get.scoop.sh" | Invoke-Expression

    # Scoop's installer appends its shim dir to the *user* PATH, which this
    # already-running process does not observe. Refresh PATH here or every
    # Get-Command below misses the tool it just installed.
    $env:PATH = [Environment]::GetEnvironmentVariable("Path", "User") + ";" +
                [Environment]::GetEnvironmentVariable("Path", "Machine")
}

# ── 2 and 3. Update, then apply the declarative file ──────────────────
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Updating Scoop and its buckets before installing anything..."
    scoop update

    $scoopfile = Join-Path "{{ .chezmoi.sourceDir }}" "scoopfile.json"
    if (Test-Path $scoopfile) {
        Write-Host "Importing buckets and apps from scoopfile.json..."
        scoop import $scoopfile
    } else {
        Write-Warning "scoopfile.json not found at $scoopfile"
    }
} else {
    Write-Warning "Scoop unavailable — portable tools skipped. Re-run this machine's apply or scripts/bootstrap.ps1."
}

# ── 4. winget: lo que necesita integración con Windows ────────────────
if (Get-Command winget -ErrorAction SilentlyContinue) {
    foreach ($pkg in $wingetPackages) {
        Write-Host "Installing $pkg via winget..."
        # --exact: without it, Microsoft.PowerShell resolves to the Preview package.
        & winget install --id $pkg --exact --silent --accept-package-agreements --accept-source-agreements
    }
} else {
    Write-Warning "winget not found — Git, PowerShell and rustup skipped."
}

# ── 5. Cleanup ────────────────────────────────────────────────────────
# Old app versions pile up in ~\scoop\apps and every installer stays cached in
# ~\scoop\cache. Cleanup runs last so it never deletes something still needed.
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Removing old versions and the download cache..."
    scoop cleanup -a
    scoop cache rm -a
}
