{{- $signingKey := includeTemplate ".chezmoitemplates/git-signing-key.tmpl" . | trim -}}
[core]
{{- if lookPath "delta" }}
    pager = delta
{{- end }}
{{- if lookPath "code" }}
    editor = code --wait
{{- else if lookPath "nvim" }}
    editor = nvim
{{- end }}

    autocrlf = input
{{- if ne .chezmoi.os "windows" }}
    filemode = true
{{- end }}

    untrackedCache = true

[init]
    defaultBranch = {{ .git.default_branch }}

[push]
    autoSetupRemote = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = zdiff3

[rebase]
    autosquash = true
    autostash = true
    updateRefs = true

[fetch]
    prune = true

[rerere]
    enabled = true

[help]
    autocorrect = 10

{{- if lookPath "delta" }}
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    
    side-by-side = true
    line-numbers = true
    theme = Monokai Extended Bright
{{- end }}

[alias]
    st = status
    cm = commit -m
    br = branch
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    f = "!git ls-files | fd"
    co = checkout
    rb = rebase
    rbi = rebase -i
    ap = add -p
    dc = diff --cached
    amend = commit --amend --no-edit
    unstage = reset HEAD --
    wip = commit -m "wip"

[include]
    path = ~/.gitconfig.local

[commit]
{{- if $signingKey }}
    gpgsign = true
{{- else }}
    gpgsign = false
{{- end }}

[gpg]
    format = ssh
{{- if eq .chezmoi.os "windows" }}
[gpg "ssh"]
    program = "C:/Windows/System32/OpenSSH/ssh-keygen.exe"
{{- end }}

[tag]
{{- if $signingKey }}
    gpgsign = true
{{- else }}
    gpgsign = false
{{- end }}

[credential]
{{- if eq .chezmoi.os "windows" }}
    helper = manager
{{- else }}
    helper = cache --timeout 86400
{{- end }}

[pull]
	rebase = true
